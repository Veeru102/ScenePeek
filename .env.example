# Postgres
POSTGRES_USER=scenepeek
POSTGRES_PASSWORD=scenepeek
POSTGRES_DB=scenepeek
DATABASE_URL=postgresql+asyncpg://scenepeek:scenepeek@localhost:5434/scenepeek

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=scenepeek
S3_SECRET_KEY=scenepeek123
