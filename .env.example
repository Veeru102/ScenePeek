# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Worker
WORKER_QUEUES=cpu,ml
WORKER_METRICS_PORT=9101
MEDIA_CACHE_DIR=~/.cache/scenepeek

# Models
WHISPER_MODEL=small.en
