TEXT_EMBED_DIM=384
VISUAL_EMBED_MODEL=google/siglip-base-patch16-224
VISUAL_EMBED_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-base
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
POSTGRES_PORT=5434
